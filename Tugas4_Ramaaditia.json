    {
      "parameters": {
        "jsCode": "\nconst now = $now.setZone('Asia/Jakarta');\n\nreturn $input.all().filter(item => {\n  const row = item.json;\n\n  if (String(row.Status ?? '').trim().toLowerCase() !== 'pending') {\n    return false;\n  }\n\n  const date = String(row['Scheduled Date'] ?? '').trim();\n  const time = String(row['Scheduled Time'] ?? '').trim();\n\n  const [day, month, year] = date.split('/').map(Number);\n  const [hour, minute, second = 0] = time.split(':').map(Number);\n\n  if (\n    !day || !month || !year ||\n    hour < 0 || hour > 23 ||\n    minute < 0 || minute > 59 ||\n    second < 0 || second > 59\n  ) {\n    return false;\n  }\n\n  const scheduled = $now.setZone('Asia/Jakarta').set({\n    year,\n    month,\n    day,\n    hour,\n    minute,\n    second,\n    millisecond: 0\n  });\n\n  if (!scheduled.isValid) return false;\n\n  return scheduled.toMillis() <= now.toMillis();\n});\n"
      },
